#!/usr/bin/env bash

PIPELINE_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PROJECT_ROOT="$PIPELINE_ROOT"
SAMPLES_TSV="$PIPELINE_ROOT/config/smoke_samples.tsv"
DATA_DIR="$PIPELINE_ROOT/slurm_toy/data"
OUTPUT_DIR="$PIPELINE_ROOT/slurm_toy/output"
LOG_DIR="$PIPELINE_ROOT/slurm_toy/logs"
