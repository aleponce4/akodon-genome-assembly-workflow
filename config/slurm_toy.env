REPEATMODELER_PARTITION="${TOY_PARTITION:-short}"
REPEATMODELER_QOS="${TOY_QOS:-short}"
REPEATMODELER_TIME="00:05:00"
REPEATMODELER_CPUS=1
REPEATMODELER_MEM="1G"
REPEATMODELER_ARRAY_CONCURRENCY=1

REPEAT_LIBRARY_PARTITION="${TOY_PARTITION:-short}"
REPEAT_LIBRARY_QOS="${TOY_QOS:-short}"
REPEAT_LIBRARY_TIME="00:05:00"
REPEAT_LIBRARY_CPUS=1
REPEAT_LIBRARY_MEM="1G"

REPEATMASKER_PARTITION="${TOY_PARTITION:-short}"
REPEATMASKER_QOS="${TOY_QOS:-short}"
REPEATMASKER_TIME="00:05:00"
REPEATMASKER_CPUS=1
REPEATMASKER_MEM="1G"
REPEATMASKER_ARRAY_CONCURRENCY=1

ANNOTATION_PREPROCESS_PARTITION="${TOY_PARTITION:-short}"
ANNOTATION_PREPROCESS_QOS="${TOY_QOS:-short}"
ANNOTATION_PREPROCESS_TIME="00:05:00"
ANNOTATION_PREPROCESS_CPUS=1
ANNOTATION_PREPROCESS_MEM="1G"

ANNOTATION_DOWNLOAD_PARTITION="${TOY_PARTITION:-short}"
ANNOTATION_DOWNLOAD_QOS="${TOY_QOS:-short}"
ANNOTATION_DOWNLOAD_TIME="00:05:00"
ANNOTATION_DOWNLOAD_CPUS=1
ANNOTATION_DOWNLOAD_MEM="1G"

ANNOTATION_PROTEIN_PREP_PARTITION="${TOY_PARTITION:-short}"
ANNOTATION_PROTEIN_PREP_QOS="${TOY_QOS:-short}"
ANNOTATION_PROTEIN_PREP_TIME="00:05:00"
ANNOTATION_PROTEIN_PREP_CPUS=1
ANNOTATION_PROTEIN_PREP_MEM="1G"

GALBA_PARTITION="${TOY_PARTITION:-short}"
GALBA_QOS="${TOY_QOS:-short}"
GALBA_TIME="00:05:00"
GALBA_CPUS=1
GALBA_MEM="1G"

BRAKER2_PARTITION="${TOY_PARTITION:-short}"
BRAKER2_QOS="${TOY_QOS:-short}"
BRAKER2_TIME="00:05:00"
BRAKER2_CPUS=1
BRAKER2_MEM="1G"

RNA_ALIGN_PARTITION="${TOY_PARTITION:-short}"
RNA_ALIGN_QOS="${TOY_QOS:-short}"
RNA_ALIGN_TIME="00:05:00"
RNA_ALIGN_CPUS=1
RNA_ALIGN_MEM="1G"
RNA_ALIGN_ARRAY_CONCURRENCY=1

BRAKER3_PARTITION="${TOY_PARTITION:-short}"
BRAKER3_QOS="${TOY_QOS:-short}"
BRAKER3_TIME="00:05:00"
BRAKER3_CPUS=1
BRAKER3_MEM="1G"

TSEBRA_PARTITION="${TOY_PARTITION:-short}"
TSEBRA_QOS="${TOY_QOS:-short}"
TSEBRA_TIME="00:05:00"
TSEBRA_CPUS=1
TSEBRA_MEM="1G"

ISOFORM_PARTITION="${TOY_PARTITION:-short}"
ISOFORM_QOS="${TOY_QOS:-short}"
ISOFORM_TIME="00:05:00"
