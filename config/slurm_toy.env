MULTIQC_PARTITION="${TOY_PARTITION:-short}"
MULTIQC_QOS="${TOY_QOS:-short}"
MULTIQC_TIME="00:05:00"
MULTIQC_CPUS=1
MULTIQC_MEM="1G"

BUSCO_PLOT_PARTITION="${TOY_PARTITION:-short}"
BUSCO_PLOT_QOS="${TOY_QOS:-short}"
BUSCO_PLOT_TIME="00:05:00"
BUSCO_PLOT_CPUS=1
