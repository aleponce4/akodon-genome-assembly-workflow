#!/usr/bin/env bash

PIPELINE_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PROJECT_ROOT="$PIPELINE_ROOT"
SAMPLES_TSV="$PIPELINE_ROOT/config/smoke_samples.tsv"
DATA_DIR="$PIPELINE_ROOT/slurm_toy/data"
OUTPUT_DIR="$PIPELINE_ROOT/slurm_toy/output"
LOG_DIR="$PIPELINE_ROOT/slurm_toy/logs"
RNA_SEQ_DIR="$PIPELINE_ROOT/slurm_toy/RNA_seq"
ANNOTATION_DIR="$PIPELINE_ROOT/slurm_toy/annotation"
ANNOTATION_FUNCTIONAL_DIR="$PIPELINE_ROOT/slurm_toy/annotation_functional"

USER_SMOKE_TEST_MODE="${SMOKE_TEST_MODE-}"
USER_ENABLE_PREFLIGHT="${ENABLE_PREFLIGHT-}"
USER_ENABLE_ANNOTATION="${ENABLE_ANNOTATION-}"
USER_ENABLE_ANNOTATION_PROTEIN_DOWNLOAD="${ENABLE_ANNOTATION_PROTEIN_DOWNLOAD-}"
USER_ENABLE_ANNOTATION_PROTEIN_PREPROCESS="${ENABLE_ANNOTATION_PROTEIN_PREPROCESS-}"
USER_ENABLE_BUSCO_PLOT="${ENABLE_BUSCO_PLOT-}"
USER_ENABLE_GALBA="${ENABLE_GALBA-}"
USER_ENABLE_BRAKER3="${ENABLE_BRAKER3-}"
USER_ENABLE_RNA_ALIGNMENT="${ENABLE_RNA_ALIGNMENT-}"
USER_ENABLE_TSEBRA="${ENABLE_TSEBRA-}"
USER_ENABLE_ISOFORM_FILTER="${ENABLE_ISOFORM_FILTER-}"
USER_ENABLE_REASSIGN_HEADERS="${ENABLE_REASSIGN_HEADERS-}"
USER_ENABLE_INTERPROSCAN="${ENABLE_INTERPROSCAN-}"
USER_ENABLE_BRAKER2="${ENABLE_BRAKER2-}"
USER_ANNOTATION_SAMPLE_MODE="${ANNOTATION_SAMPLE_MODE-}"
USER_ANNOTATION_SAMPLE_ID="${ANNOTATION_SAMPLE_ID-}"
USER_ANNOTATION_FINAL_MODEL="${ANNOTATION_FINAL_MODEL-}"
USER_INTERPROSCAN_RUN_NAME="${INTERPROSCAN_RUN_NAME-}"
USER_REPEATMODELER_IMAGE="${REPEATMODELER_IMAGE-}"
USER_BRAKER_SIF="${BRAKER_SIF-}"
USER_GALBA_SIF="${GALBA_SIF-}"
USER_INTERPROSCAN_SIF="${INTERPROSCAN_SIF-}"

# shellcheck disable=SC1091
source "$PIPELINE_ROOT/config/pipeline.env"

SMOKE_TEST_MODE="${USER_SMOKE_TEST_MODE:-1}"
ENABLE_PREFLIGHT="${USER_ENABLE_PREFLIGHT:-1}"
ENABLE_ANNOTATION="${USER_ENABLE_ANNOTATION:-1}"
ENABLE_ANNOTATION_PROTEIN_DOWNLOAD="${USER_ENABLE_ANNOTATION_PROTEIN_DOWNLOAD:-1}"
ENABLE_ANNOTATION_PROTEIN_PREPROCESS="${USER_ENABLE_ANNOTATION_PROTEIN_PREPROCESS:-1}"
ENABLE_BUSCO_PLOT="${USER_ENABLE_BUSCO_PLOT:-1}"
ENABLE_GALBA="${USER_ENABLE_GALBA:-1}"
ENABLE_BRAKER3="${USER_ENABLE_BRAKER3:-1}"
ENABLE_RNA_ALIGNMENT="${USER_ENABLE_RNA_ALIGNMENT:-1}"
ENABLE_TSEBRA="${USER_ENABLE_TSEBRA:-1}"
ENABLE_ISOFORM_FILTER="${USER_ENABLE_ISOFORM_FILTER:-1}"
ENABLE_REASSIGN_HEADERS="${USER_ENABLE_REASSIGN_HEADERS:-1}"
ENABLE_INTERPROSCAN="${USER_ENABLE_INTERPROSCAN:-1}"
ENABLE_BRAKER2="${USER_ENABLE_BRAKER2:-0}"
ANNOTATION_SAMPLE_MODE="${USER_ANNOTATION_SAMPLE_MODE:-all}"
ANNOTATION_SAMPLE_ID="${USER_ANNOTATION_SAMPLE_ID:-SAMPLE03}"
ANNOTATION_FINAL_MODEL="${USER_ANNOTATION_FINAL_MODEL:-tsebra_config_1}"
INTERPROSCAN_RUN_NAME="${USER_INTERPROSCAN_RUN_NAME:-$ANNOTATION_FINAL_MODEL}"

REPEATMODELER_IMAGE="${USER_REPEATMODELER_IMAGE:-$PIPELINE_ROOT/annotation/singularity_images/tetools_latest.sif}"
BRAKER_SIF="${USER_BRAKER_SIF:-$PIPELINE_ROOT/annotation/singularity_images/braker3.sif}"
GALBA_SIF="${USER_GALBA_SIF:-$PIPELINE_ROOT/annotation/singularity_images/galba.sif}"
INTERPROSCAN_SIF="${USER_INTERPROSCAN_SIF:-$PIPELINE_ROOT/annotation_functional/data/bin/interproscan_latest.sif}"

SUPERNOVA_PARTITION="${TOY_PARTITION:-short}"
SUPERNOVA_QOS="${TOY_QOS:-short}"
SUPERNOVA_TIME="00:05:00"
SUPERNOVA_CPUS=1
SUPERNOVA_MEM="1G"
SUPERNOVA_LOCALCORES=1
SUPERNOVA_LOCALMEM=1
SUPERNOVA_ARRAY_CONCURRENCY=1

PREFLIGHT_PARTITION="${TOY_PARTITION:-short}"
PREFLIGHT_QOS="${TOY_QOS:-short}"
PREFLIGHT_TIME="00:10:00"
PREFLIGHT_CPUS=1
PREFLIGHT_MEM="1G"

MKOUTPUT_PARTITION="${TOY_PARTITION:-short}"
MKOUTPUT_QOS="${TOY_QOS:-short}"
MKOUTPUT_TIME="00:05:00"
MKOUTPUT_CPUS=1
MKOUTPUT_MEM="1G"
MKOUTPUT_ARRAY_CONCURRENCY=1

FILTER_PARTITION="${TOY_PARTITION:-short}"
FILTER_QOS="${TOY_QOS:-short}"
FILTER_TIME="00:05:00"
FILTER_CPUS=1
FILTER_MEM="1G"
FILTER_ARRAY_CONCURRENCY=1

QUAST_PARTITION="${TOY_PARTITION:-short}"
QUAST_QOS="${TOY_QOS:-short}"
QUAST_TIME="00:05:00"
QUAST_CPUS=1
QUAST_MEM="1G"

BUSCO_PARTITION="${TOY_PARTITION:-short}"
BUSCO_QOS="${TOY_QOS:-short}"
BUSCO_TIME="00:05:00"
BUSCO_CPUS=1
BUSCO_MEM="1G"
