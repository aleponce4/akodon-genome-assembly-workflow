ISOFORM_MEM="1G"

REASSIGN_PARTITION="${TOY_PARTITION:-short}"
REASSIGN_QOS="${TOY_QOS:-short}"
REASSIGN_TIME="00:05:00"
REASSIGN_CPUS=1
REASSIGN_MEM="1G"

INTERPROSCAN_PARTITION="${TOY_PARTITION:-short}"
INTERPROSCAN_QOS="${TOY_QOS:-short}"
INTERPROSCAN_TIME="00:05:00"
INTERPROSCAN_CPUS=1
INTERPROSCAN_MEM="1G"

ANNOTATION_ARRAY_CONCURRENCY=1
